PORT=3000
INTERNAL_API_TOKEN=replace-with-a-long-random-token
DATABASE_URL=
NODE_ENV=development
OPENAI_API_KEY=
AI_MODEL_REASONING=gpt-5.4-mini
AI_MODEL_STANDARD=gpt-5.4-mini
AI_MODEL_CHEAP=gpt-5.4-nano
AI_MAX_TURNS_PER_AGENT=4
AI_MAX_REQUESTS_PER_RUN=8
AI_MAX_TOKENS_PER_RUN=30000

# Optional OpenAI vector store for larger Astel knowledge corpora.
# Local curated skill/knowledge packs work without this.
ASTEL_KNOWLEDGE_VECTOR_STORE_ID=
ASTEL_KNOWLEDGE_MAX_RESULTS=5

# Edie Analytics Hub
ANALYTICS_SYNC_ENABLED=true
ANALYTICS_SYNC_INTERVAL_MS=21600000
ANALYTICS_SYNC_LOOKBACK_DAYS=30

# Read-only Social Engine analytics export.
SOCIAL_ANALYTICS_BASE_URL=
SOCIAL_ANALYTICS_TOKEN=

# Optional YouTube Data + YouTube Analytics read-only OAuth.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ANALYTICS_PROJECT_ID=battle-box
YOUTUBE_ANALYTICS_ACCOUNT_KEY=astel-family
YOUTUBE_ANALYTICS_MAX_VIDEOS=50

# Optional pricing override. Unknown models remain unpriced rather than guessed.
AI_PRICING_VERSION=
AI_PRICING_JSON=
